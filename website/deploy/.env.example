# OBIE website: environment file of compose.yaml. Copy it to .env next to
# compose.yaml, fill in every value marked REQUIRED and keep the file private
# (chmod 600): it holds the database password, the SMTP password and the
# inquiry secret. The values below are examples, not secrets.
#
# Optional settings are commented out and show the application's default;
# uncomment a line only to change it, and never leave a value empty.
# Durations are ISO-8601 (PT3S = 3 seconds, PT1H = 1 hour, P1D = 1 day),
# periods too (P12M = 12 months).

# --- Image and network -------------------------------------------------------

# Image to run. Pin a released version (tag website-v1.2.3 → image 1.2.3).
OBIE_IMAGE=ghcr.io/mncloudwerkstechnology/obie-website:latest
# Address and port the website listens on for the reverse proxy. Keep it on
# 127.0.0.1 when the proxy runs on the host; never publish it to the internet
# without a proxy in front (see README.md, "Reverse proxy").
OBIE_HTTP_BIND=127.0.0.1:8080
# How the website learns the visitor's address and scheme: `native` takes
# X-Forwarded-For/-Proto from a proxy on a private or loopback address;
# `none` ignores them (only without any proxy).
#SERVER_FORWARD_HEADERS_STRATEGY=native

# --- Site ------------------------------------------------------------------

# REQUIRED. Public origin of the site (scheme, host, optional port; no path,
# no trailing slash): canonical URLs, sitemap, robots.txt and the only
# origin allowed to call the API from a browser.
OBIE_SITE_ORIGIN=https://obie.example

# --- Database (PostgreSQL in compose.yaml) -----------------------------------

# Database and user are created on the first start with these values; changing
# them later does not rename an existing database or user.
#OBIE_DB_NAME=obie
#OBIE_DB_USERNAME=obie
# REQUIRED. A long random password, e.g. `openssl rand -base64 32`.
OBIE_DB_PASSWORD=change-me-database-password

# --- Mail (SMTP) -------------------------------------------------------------

# REQUIRED. SMTP server that sends the inquiry mails.
OBIE_SMTP_HOST=smtp.example.org
# 587 for STARTTLS, 465 for TLS from the start (then OBIE_SMTP_SSL=true and
# OBIE_SMTP_STARTTLS=false).
#OBIE_SMTP_PORT=587
# Credentials, if the server needs authentication.
OBIE_SMTP_USERNAME=website@obie.example
OBIE_SMTP_PASSWORD=change-me-smtp-password
#OBIE_SMTP_STARTTLS=true
#OBIE_SMTP_SSL=false
# REQUIRED. Sender of all mails; the SMTP server must allow it.
OBIE_MAIL_FROM=website@obie.example
# Delivery retries when the SMTP server fails (exponential backoff).
#OBIE_MAIL_MAX_ATTEMPTS=10
#OBIE_MAIL_RETRY_INITIAL_DELAY=PT1M
#OBIE_MAIL_RETRY_MAX_DELAY=PT6H

# --- Inquiries -----------------------------------------------------------------

# REQUIRED. Address that receives every inquiry.
OBIE_INQUIRY_RECIPIENT=inquiries@obie.example
# REQUIRED. At least 32 characters, e.g. `openssl rand -base64 32`. Keep it
# stable: it salts the stored IP hashes and signs the form tokens.
OBIE_INQUIRY_SECRET=change-me-at-least-32-characters-long-secret
# Rate limit: inquiries per visitor IP (IPv6: per /64) within the period.
#OBIE_INQUIRY_RATE_LIMIT=5
#OBIE_INQUIRY_RATE_LIMIT_PERIOD=PT1H
# Bot protection: minimum time between showing the form and sending it, and
# the maximum age of a shown form.
#OBIE_INQUIRY_MIN_FILL_TIME=PT3S
#OBIE_INQUIRY_FORM_TOKEN_MAX_AGE=P1D
# Retention: stored inquiries older than this are deleted daily at 03:30 UTC.
# The privacy policy states 12 months; change it there, too.
#OBIE_INQUIRY_RETENTION=P12M

# --- GitHub project stats ----------------------------------------------------

# Optional token for the server-side stats requests (fine-grained, read-only
# access to public repositories). Without one, GitHub allows 60 requests per
# hour, which the cache stays well below.
#OBIE_GITHUB_TOKEN=
#OBIE_GITHUB_REPOSITORY=MNCloudwerksTechnology/OBIE-Open-Ban-Intelligence-Exchange
#OBIE_GITHUB_CACHE_TTL=PT15M
#OBIE_GITHUB_RETRY_DELAY=PT1M
#OBIE_GITHUB_API_URL=https://api.github.com
